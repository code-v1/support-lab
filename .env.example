# Keys stay on the server. Configure all three profiles before starting a call.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
FAST_PROVIDER=openrouter
FAST_MODEL=anthropic/claude-haiku-5.5
FAST_REASONING=off
FAST_MAX_OUTPUT_TOKENS=1024
BALANCED_PROVIDER=openrouter
BALANCED_MODEL=deepseek/deepseek-v4.1-flash
BALANCED_REASONING=low
BALANCED_MAX_OUTPUT_TOKENS=4096
ADVANCED_PROVIDER=openrouter
ADVANCED_MODEL=anthropic/claude-sonnet-5.5
ADVANCED_REASONING=medium
ADVANCED_MAX_OUTPUT_TOKENS=8192
# OpenAI example: PROVIDER=openai and MODEL=gpt-4.1-mini (or your available model).
# Direct Gemini example: PROVIDER=google and MODEL=gemini-2.5-flash.
# OpenRouter requires provider-prefixed model IDs and only OPENROUTER_API_KEY.
DATABASE_PATH=./data/support-lab.sqlite
# Optional browser tool. Run npm run browser:install first.
ENABLE_BROWSER_TOOLS=false
APP_BASE_URL=http://127.0.0.1:3000
